      "source": {
        "source": "github",
        "repo": "tj-agents/marketplace"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "agent-store@tj-agents": true,
    "agent@tj-agents": true,
    "base@tj-agents": true,
    "cli@tj-agents": true,
    "engineering@tj-agents": true,
    "github-actions@tj-agents": true,
    "personal@tj-agents": true,
    "python@tj-agents": true,
    "rust@tj-agents": true,
    "template@tj-agents": true,
    "workflow@tj-agents": true
  },
  "permissions": {
    "allow": []
  }
}
